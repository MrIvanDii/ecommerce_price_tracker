# создай файл .env.example в корне проекта с таким содержимым:
GOOGLE_SHEETS_CREDENTIALS_PATH=secrets/google_service_account.json
GOOGLE_SHEETS_SPREADSHEET_ID=your_spreadsheet_id

REQUEST_DELAY_SECONDS=1
RETRY_COUNT=3
TIMEOUT=20
HISTORY_RETENTION_DAYS=90

DB_HOST=localhost
DB_PORT=3306
DB_NAME=gold_tracker
DB_USER=root
DB_PASSWORD=